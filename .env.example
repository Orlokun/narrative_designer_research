# Copy to .env and fill in values. .env is gitignored.

# ---- Research project: which historical moment the agents research ----
# A slug under projects/<slug>/project.yaml, or a path to a YAML spec.
RESEARCH_PROJECT=cybersyn

# ---- LLM provider: ollama (local server) | gemini (Google AI Studio API) ----
LLM_PROVIDER=ollama
# Gemini / Google AI Studio — serves the open Gemma models on a free tier (no local GPU needed).
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it
GEMINI_RPM=25

# ---- Ollama ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_NPC=gemma4:e4b
OLLAMA_MODEL_DIRECTOR=gemma4:26b
OLLAMA_MODEL_EMBED=bge-m3
# Optional fine-tuned adapter served via a Modelfile built on top of gemma4:e4b
OLLAMA_MODEL_NPC_ADAPTER=gemma4-floresian:latest

# ---- Paths (relative to agents/) ----
DATA_DIR=./data
ARCHIVE_DB=./data/archivo/archivo.sqlite
CHROMA_DIR=./data/chroma
DATASETS_DIR=./data/datasets
LOGS_DIR=./data/logs
CHECKPOINTS_DIR=./data/checkpoints

# ---- Runtime ----
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# ---- Admin Dashboard ----
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080

# ---- Gatekeeper (Research Engine, offline only) ----
GATEKEEPER_HOST=127.0.0.1
GATEKEEPER_PORT=8001
GATEKEEPER_CACHE_TTL_DAYS=7
GATEKEEPER_CIRCUIT_BREAKER_THRESHOLD=3
GATEKEEPER_COOLDOWN_MINUTES=15.0

# ---- Experiment ----
EXPERIMENT_CONDITION=baseline  # baseline | floresian

# Semantic Scholar API key (free: https://www.semanticscholar.org/product/api)
# Without it requests share the global unauthenticated pool, which 429s under
# load; with it the Gatekeeper sends x-api-key and gets a dedicated 1 rps pool.
SEMANTIC_SCHOLAR_API_KEY=
